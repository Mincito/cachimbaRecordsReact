# Copia a .env cuando tu compañero te confirme la configuración.
# Se admite SOLO la clave pública/publishable (NUNCA service_role/secret keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Nombre REAL de la tabla de vinilos creada por tu compañero.
VITE_SUPABASE_PRODUCTS_TABLE=
# Opcional: tabla real para recibir mensajes, con políticas RLS de INSERT apropiadas.
VITE_SUPABASE_CONTACTS_TABLE=
